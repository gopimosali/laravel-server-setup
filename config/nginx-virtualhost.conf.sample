##################################################
# HTTP to HTTPS Redirect                        #
##################################################
#
# Uncomment to force HTTPS (after SSL is configured)
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name example.com www.example.com;
#     return 301 https://$server_name$request_uri;
# }

##################################################
# Multiple Apps Configuration                   #
##################################################
#
# To host multiple applications, create separate config files:
# /etc/nginx/sites-available/app1
# /etc/nginx/sites-available/app2
#
# Each with their own server block:
#
# server {
#     listen 80;
#     server_name app1.example.com;
#     root /var/www/html/app1/public;
#     ...
# }

##################################################
# PHP-FPM Pool Configuration (Optional)         #
##################################################
#
# For better resource isolation, create dedicated PHP-FPM pools
# Edit: /etc/php/8.4/fpm/pool.d/your-app.conf
#
# [your-app]
# user = www-data
# group = www-data
# listen = /run/php/php8.4-fpm-your-app.sock
# listen.owner = www-data
# listen.group = www-data
# pm = dynamic
# pm.max_children = 5
# pm.start_servers = 2
# pm.min_spare_servers = 1
# pm.max_spare_servers = 3
# pm.max_requests = 500
#
# Then update fastcgi_pass in this config to:
# fastcgi_pass unix:/run/php/php8.4-fpm-your-app.sock;

##################################################
# Laravel Specific Configuration                #
##################################################
#
# For Laravel applications, ensure:
# 1. Root points to the /public directory
# 2. try_files includes /index.php?$query_string
# 3. Proper file permissions:
#    sudo chown -R www-data:www-data /var/www/html/your-app
#    sudo chmod -R 755 /var/www/html/your-app
#    sudo chmod -R 775 /var/www/html/your-app/storage
#    sudo chmod -R 775 /var/www/html/your-app/bootstrap/cache

##################################################
# Performance Tips                              #
##################################################
#
# 1. Enable FastCGI caching:
#    fastcgi_cache_path /var/cache/nginx levels=1:2 keys_zone=PHPCACHE:100m inactive=60m;
#    fastcgi_cache_key "$scheme$request_method$host$request_uri";
#
#    In location ~ \.php$ block:
#    fastcgi_cache PHPCACHE;
#    fastcgi_cache_valid 200 60m;
#
# 2. Use HTTP/2 (already included in SSL block above)
#
# 3. Enable open file cache in /etc/nginx/nginx.conf:
#    open_file_cache max=10000 inactive=20s;
#    open_file_cache_valid 30s;
#    open_file_cache_min_uses 2;
#    open_file_cache_errors on;

##################################################
# Testing Configuration                         #
##################################################
#
# After making changes:
# 1. Test syntax: sudo nginx -t
# 2. Reload Nginx: sudo systemctl reload nginx
# 3. Check status: sudo systemctl status nginx
# 4. View logs: sudo tail -f /var/log/nginx/your-app-error.log
